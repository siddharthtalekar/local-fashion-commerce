# ============================================================
# LocalFashion Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# We use PostgreSQL for both local development and production.
# You can get a free Postgres database from Supabase, Neon, or Railway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Auth Secrets ───────────────────────────────────────────
# CHANGE THESE IN PRODUCTION — use long random strings (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET="CHANGE_IN_PRODUCTION_use_a_random_32_char_string"
JWT_REFRESH_SECRET="CHANGE_IN_PRODUCTION_use_a_different_random_32_char_string"

# ── API Server ─────────────────────────────────────────────
PORT=4000
# Comma-separated allowed CORS origins (no spaces after commas)
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Customer PWA (Next.js public env vars) ─────────────────
# URL that the browser (client-side) uses to reach the API
# For local dev, use your machine's LAN IP so mobile devices can connect
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# URL the Next.js server (SSR) uses to reach the API internally
API_URL_SERVER="http://localhost:4000/api"

# ── Platform Config ────────────────────────────────────────
# Slug of the pilot city (must match a City record in the database)
NEXT_PUBLIC_PILOT_CITY_SLUG="pune"
PILOT_CITY_SLUG="pune"
NEXT_PUBLIC_PLATFORM_NAME="LocalFashion"

# ── 3rd Party APIs ──────────────────────────────────────────
# Google Maps Embed API Key (Required for store location maps)
NEXT_PUBLIC_GOOGLE_MAPS_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"
